<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>

	<snippets>
		<snippet name="game">
			<Panel class="flow-right mb-2 reqgames__game">
				<Image id="Icon" style="width: 20px; height: 20px;" />
				<Label class="ml-2 mr-3 v-align-center text-medium reqgames__game-name" text="{s:game}" />
				<Label id="MountedStatus" class="v-align-center text-medium mr-1 reqgames__game-status" text="{s:mounted_status}" />
				<Image id="MountedIcon" class="v-align-center" style="width: 12px; height: 12px;" />
			</Panel>
		</snippet>
	</snippets>

	<scripts>
		<include type="module" src="file://{scripts}/modals/popups/required-games.ts" />
	</scripts>

	<PopupCustomLayout class="PopupPanel Hidden generic-popup generic-popup--large reqgames" popupbackground="blur">
		<Panel class="flow-down reqgames__body">
			<Label class="text-h2 mb-4 text-align-center reqgames__title" text="#MapSelector_RequiredGames_Title" />
			<Label class="mb-2 reqgames__message" text="#MapSelector_RequiredGames_PopupMessage1" />
			<Label class="mb-4 reqgames__message" text="#MapSelector_RequiredGames_PopupMessage2" />
			<Panel id="Games" class="flow-down mb-3" />
		</Panel>

		<Panel class="flow-right h-align-right reqgames__buttons">
			<ToggleButton id="DontShowAgainCheckbox" class="checkbox v-align-center mr-4 reqgames__check">
				<Label class="reqgames__check-label" text="#Common_DontShowAgain" />
			</ToggleButton>
			<Button class="button button--blue mr-3 reqgames__btn" onactivate="RequiredGamesPopupHandler.submit()">
				<Label class="button__text reqgames__btn-text" text="#Common_IUnderstand" />
			</Button>
			<Button class="button button--red reqgames__btn" onactivate="RequiredGamesPopupHandler.cancel()">
				<Label class="button__text reqgames__btn-text" text="#Common_Cancel" />
			</Button>
		</Panel>
	</PopupCustomLayout>

</root>
